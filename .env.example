# Optional model-backed invention generation. Keep real keys out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth. Register this exact callback URL with your Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate a random secret of at least 32 characters.
AUTH_SESSION_SECRET=
# Optional CSV allowlist, e.g. owner@example.com,teammate@example.com.
# Empty means any Google account with a verified email may sign in.
GOOGLE_ALLOWED_EMAILS=

# Do not trust ChatGPT identity headers on a public Cloud Run service.
AUTH_TRUST_CHATGPT_HEADERS=false
# Random secret (32+ chars) used to hash per-user paid inference quota identities.
DISCLOSURE_RATE_LIMIT_HMAC_SECRET=
# Keep false unless all traffic passes a trusted Cloudflare edge and direct origin access is blocked.
DISCLOSURE_TRUST_CF_EDGE=false

# Optional host port for Docker Compose; the app listens on port 3000 inside Compose.
PORT=3000
