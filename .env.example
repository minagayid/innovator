# Optional model-backed disclosure generation. Keep real keys out of Git.
# Compose uses a deterministic fallback when no provider key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional host port; the container always listens on port 3000.
PORT=3000
