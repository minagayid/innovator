{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://innovator.local/schemas/tool-manifest-1.0.json",
  "title": "Portable callable tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "function", "execution", "result", "errors", "tests"],
  "properties": {
    "kind": {"const": "function"},
    "schema_version": {"const": "1.0"},
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "strict", "parameters"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "description": {"type": "string", "minLength": 10},
        "strict": {"const": true},
        "parameters": {"$ref": "#/$defs/objectSchema"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external_side_effects", "idempotent", "timeout_ms"],
      "properties": {
        "mode": {"enum": ["read_only", "write", "destructive"]},
        "external_side_effects": {"type": "boolean"},
        "idempotent": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 300000}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {"required": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {"required": {"type": "boolean"}}
    },
    "result": {"type": "object", "additionalProperties": false, "required": ["schema"], "properties": {"schema": {"type": "object"}}},
    "errors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "retryable", "description"], "additionalProperties": false, "properties": {"code": {"type": "string"}, "retryable": {"type": "boolean"}, "description": {"type": "string"}}}},
    "tests": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["name", "kind", "input"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "kind": {"enum": ["valid", "invalid"]}, "input": {}, "mock_output": {}}}}
  },
  "$defs": {
    "objectSchema": {
      "type": "object",
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": {"const": "object"},
        "properties": {"type": "object"},
        "required": {"type": "array", "items": {"type": "string"}},
        "additionalProperties": {"const": false}
      }
    }
  }
}
