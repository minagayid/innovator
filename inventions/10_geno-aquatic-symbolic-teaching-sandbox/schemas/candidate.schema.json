{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/geno-aquatic/candidate.schema.json",
  "title": "GENO-AQUATIC synthetic symbolic candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "model_context", "trait_hypothesis", "symbolic_features", "evidence_status", "limitations", "research_only"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "candidate_id": {"type": "string", "pattern": "^GA-CAND-[0-9]{3}$"},
    "model_context": {"const": "synthetic_aquatic_analogue"},
    "trait_hypothesis": {"type": "string", "minLength": 12},
    "symbolic_features": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SYMBOL_[A-Z0-9_]+$"}},
    "evidence_status": {"enum": ["synthetic_example", "hypothesis_only", "unverified"]},
    "limitations": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "research_only": {"const": true}
  }
}
