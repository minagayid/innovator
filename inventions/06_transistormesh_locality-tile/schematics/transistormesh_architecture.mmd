flowchart TB
  W["Fixed INT8/INT4 workload + trace"] --> MAP["Trace-guided locality mapping"]
  MAP --> TILE

  subgraph TILE["Candidate accelerator tile — process-portable Rev-A"]
    RF["Per-cluster register files"] --> MAC["Narrow SIMD / MAC lanes"]
    SRAM["Local SRAM banks"] --> RF
    MAC --> MESH["Segmented nearest-neighbour links\nwith isolation / gating"]
    MESH --> RF
    CTRL["Clock / power gating controller"] --> MAC
    CTRL --> MESH
    PDN["Explicit PDN + guard-band model"] --> MAC
    PDN --> SRAM
  end

  TILE --> E["Extract total useful-work energy:\nlogic + wire + memory + clock + leakage + PDN + control"]
  BASE["Matched conventional bus / systolic baseline\nsame PDK, workload, throughput and memory"] --> CMP["Matched post-layout comparison"]
  E --> CMP
  CMP --> PASS{"Candidate total energy lower\nwith timing and declared assumptions?"}
  PASS -->|"Yes"| NEXT["Authorize next gate:\ncorner / workload replication or MPW planning"]
  PASS -->|"No"| REFRAME["Reject/reduce mesh scope:\nuse conventional local path"]

  ADV["Optional advanced flavour:\nGAA + BSPDN only with authorized calibrated PDK"] -. "not required for Rev-A evidence" .-> TILE
  BOUND["No claim of a novel transistor, universal CPU advantage, silicon yield or GAA/BSPDN hardware"]
  CMP -. "scope boundary" .-> BOUND

  classDef candidate fill:#eaf5f5,stroke:#287680,color:#173e45;
  classDef baseline fill:#edf0f8,stroke:#4c6596,color:#243657;
  classDef gate fill:#fff4dd,stroke:#9b7924,color:#503e10;
  classDef boundary fill:#fff0ec,stroke:#aa5444,color:#692d24;
  class RF,MAC,SRAM,MESH,CTRL,PDN,MAP candidate;
  class W,BASE baseline;
  class E,CMP,PASS,NEXT,REFRAME,ADV gate;
  class BOUND boundary;
