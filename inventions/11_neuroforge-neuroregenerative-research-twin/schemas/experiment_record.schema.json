{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/neuroforge/experiment_record.schema.json",
  "title": "NeuroForge abstract experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "candidate_id", "model_system_id", "research_question", "hypothesis", "endpoint_category", "evidence_refs", "safety_classification", "human_review_status", "source_provenance"],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^NF-EXP-[0-9]{3}$"},
    "candidate_id": {"type": "string", "pattern": "^NF-CAND-[0-9]{3}$"},
    "model_system_id": {"type": "string", "pattern": "^NF-MODEL-[0-9]{3}$"},
    "research_question": {"type": "string", "minLength": 10},
    "hypothesis": {"type": "string", "minLength": 10},
    "endpoint_category": {"enum": ["cell_identity", "cell_survival", "neural_function", "host_graft_connectivity", "molecular_state", "functional_outcome", "adverse_event_signal"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^NF-EVID-[0-9]{3}$"}},
    "safety_classification": {"enum": ["research_metadata_only", "requires_external_safety_review", "quarantined"]},
    "human_review_status": {"enum": ["not_reviewed", "reviewed_for_research_only", "dissent_recorded", "quarantined"]},
    "source_provenance": {"$ref": "evidence_record.schema.json#/$defs/provenance"}
  }
}
